PORT=3000
HEADLESS=false
DATA_DIR=./data
# Pause between browser steps (ms) — helps avoid Google captcha
STEP_DELAY_MS=1500
# Persistent Chrome profile (cookies) — used with npm run chrome
BROWSER_USER_DATA_DIR=./data/browser-profile
# Connect agent to real Chrome (avoids "browser not secure" on Gmail login)
USE_BROWSER_CDP=true
BROWSER_CDP_PORT=9222
BROWSER_CDP_URL=http://127.0.0.1:9222
USE_SYSTEM_CHROME=true
# Optional: vision assists non-YouTube clicks (YouTube uses DOM, no API needed)
USE_VISION_CLICK=false
# Write data/planner-last-request.md with full planner prompt + response
LOG_PLANNER_IO=false
DEFAULT_MODEL=dummy

# Hybrid router: rules + presets, then Gemini Flash orchestrator
ROUTER_CONFIDENCE_THRESHOLD=0.75
ORCHESTRATOR_MODEL=gemini-2.0-flash
# Set to false if Gemini quota is exhausted (uses rule presets only)
USE_GEMINI_ORCHESTRATOR=true
# Local cap to avoid burning Gemini free-tier quota (default 8/min)
GEMINI_MAX_REQUESTS_PER_MINUTE=8
# Cooldown after a 429 from Gemini (milliseconds)
GEMINI_COOLDOWN_MS=60000

# Provider API keys (agent registers models only for configured providers)
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
